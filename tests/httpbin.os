#Использовать ".."

&Тест
Процедура ЗапускКонтейнераHttpBin() Экспорт
	
	Образ = "kennethreitz/httpbin";

	КонтейнерHttpBin = Новый ОбщийКонтейнер(Образ)
		.ОткрытьПорт(80);

	КонтейнерHttpBin.Запустить();

	Попытка

		Адрес = "http://localhost";
		Порт = КонтейнерHttpBin.ПолучитьОткрытыйПорт(80);

		МаксПопыток = 30;
		ИнтервалОпросаМс = 1000;
		Ответ = Неопределено;

		HttpСоединение = Новый HTTPСоединение(Адрес, Порт, , , , 5);
		HttpЗапрос = Новый HTTPЗапрос;
		HttpЗапрос.АдресРесурса = "/get";

		Для НомерПопытки = 1 По МаксПопыток Цикл
			Попытка
				Ответ = HttpСоединение.Получить(HttpЗапрос);
				Если Ответ.КодСостояния = 200 Тогда
					Прервать;
				КонецЕсли;
			Исключение
				// Игнорируем ошибки соединения на ранних попытках
			КонецПопытки;
			Приостановить(ИнтервалОпросаМс);
		КонецЦикла;

		Если Ответ = Неопределено Или Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение "Ожидался код состояния 200, получен " + ?(Ответ = Неопределено, "нет ответа", Ответ.КодСостояния);
		КонецЕсли;

		КонтейнерHttpBin.Остановить();

	Исключение

		КонтейнерHttpBin.Остановить();
		ВызватьИсключение;

	КонецПопытки;

КонецПроцедуры
